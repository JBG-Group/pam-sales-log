# ---- OpenAI ----
# https://platform.openai.com/api-keys で発行
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# ---- Google Drive ----
# 音声ファイルを置くフォルダのID
# Driveでフォルダをブラウザで開いたときのURL末尾:
#   https://drive.google.com/drive/folders/【この部分】
# 複数ある場合はカンマ区切り（上から順に走査）。共有ドライブ上のフォルダも可
#   例: DRIVE_LOG_FOLDER_IDS=新フォルダID,旧フォルダID
DRIVE_LOG_FOLDER_IDS=

# 処理済みファイルの移動先サブフォルダ名（各フォルダの配下。なければ自動作成）
DONE_FOLDER_NAME=processed

# ---- Google Sheets（転記先。使わないなら空でよい）----
SPREADSHEET_ID=
SHEET_NAME=Sheet1

# ---- 音声処理 ----
# ffmpeg が PATH にない場合のみフルパスを指定
# 例(Windows): C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=

# ---- Whisper ----
WHISPER_LANGUAGE=ja
# 固有名詞のヒント。認識させたい人名・団体名・商品名をカンマ区切りで並べると精度が上がる
# 例: 山田太郎,鈴木花子,株式会社サンプル,定期演奏会
WHISPER_PROMPT=
